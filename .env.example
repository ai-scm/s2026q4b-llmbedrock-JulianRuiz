# Copia este archivo como .env y completa los valores. .env está en .gitignore.

# API key de Amazon Bedrock (consola de Bedrock > API keys). boto3 la lee sola.
AWS_BEARER_TOKEN_BEDROCK=pega-aqui-tu-api-key

# Región donde generaste la key y donde está disponible el modelo.
AWS_REGION=us-east-1

# ID del modelo o del inference profile (prefijo us. = enrutamiento entre regiones de EE. UU.).
# Alternativa sin formulario de Anthropic: us.amazon.nova-lite-v1:0
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Parámetros opcionales del modelo
TEMPERATURE=0.3
MAX_TOKENS=1024
MAX_HISTORY_MESSAGES=20
